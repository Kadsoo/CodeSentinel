{
  "name": "codesentinel-workspace",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.17.0",
    "npm": "10.9.2"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "web:dev": "npm --workspace @kadsoo/codesentinel-web run dev",
    "web:build": "npm --workspace @kadsoo/codesentinel-web run build",
    "demo": "tsx scripts/mechanism-demo.ts",
    "demo:mechanisms": "tsx scripts/mechanism-demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "fastify": "5.10.0",
    "keytar": "7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.17.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "jsdom": "27.3.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
